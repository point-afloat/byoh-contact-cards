# Model endpoint (any OpenAI-compatible chat-completions API with image input).
LLM_BASE_URL=https://api.mistral.ai/v1
# Cheapest vision-capable model that is accurate enough on real cards (chosen in task 2.4).
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# json_schema (structured output, default) or json_object. With json_schema the app falls
# back to json_object by itself if the endpoint says it does not support schemas.
LLM_RESPONSE_FORMAT=json_schema

# FundraisingBox API token (basic auth user, password "X").
FUNDRAISINGBOX_APITOKEN=

# Where persistent data lives (a mounted volume in Docker, where it defaults to /data).
# Locally, point it at a writable folder; it is ignored by git.
DATA_DIR=./data
# Port to listen on (the container defaults to 8080).
PORT=8080

# Maximum accepted upload size in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760

# Review session lifetime (seconds of inactivity) and maximum concurrent sessions.
SESSION_TTL_SECONDS=1800
SESSION_MAX_COUNT=200

# Accounts. The first administrator is created from these when no user exists yet.
# Remove INITIAL_ADMIN_PASSWORD after the first deploy; it is ignored once any user exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Hours of inactivity before a sign-in expires, and the longest a sign-in lasts (days).
AUTH_SESSION_IDLE_HOURS=12
AUTH_SESSION_DAYS=14
# How long invitation links (hours) and password-reset links (minutes) work.
AUTH_INVITE_TTL_HOURS=168
AUTH_RESET_TTL_MINUTES=60
# Send the sign-in cookie only over HTTPS. Set false only for plain-http local development.
AUTH_COOKIE_SECURE=true
# true only behind exactly one proxy (such as Sliplane), so throttling sees real client addresses.
TRUSTED_PROXY=false

# Folder with the built web app. Only set this to serve it from somewhere else than the default
# (frontend/dist next to the code, which is where the Docker image puts it).
# STATIC_DIR=
